# --- Infra (docker/docker-compose.yml) ---
POSTGRES_USER=menuevo
POSTGRES_PASSWORD=menuevo
POSTGRES_DB=menuevo
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- apps/api (läuft auf 3001, da apps/web den Port 3000 belegt) ---
DATABASE_URL=postgresql://menuevo:menuevo@localhost:5432/menuevo
PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production
OPENAI_API_KEY=

# --- apps/web ---
VITE_API_URL=http://localhost:3001
